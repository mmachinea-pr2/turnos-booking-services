BOOKING_DB_NAME=booking
BOOKING_DB_USER=booking_app
BOOKING_DB_PASSWORD=
BOOKING_MYSQL_ROOT_PASSWORD=
BOOKING_DB_HOST=localhost
BOOKING_DB_PORT=3309
BOOKING_APP_HOST=127.0.0.1
BOOKING_APP_PORT=8081

# Base64 de al menos 32 bytes aleatorios. No usar el JWT de cátedra.
BOOKING_JWT_SECRET=
BOOKING_JWT_ISSUER=turnos-booking
BOOKING_JWT_AUDIENCE=turnos-backends
BOOKING_JWT_TTL=30m
# Vacío: no admite clientes web de otro origen. KMP nativo no requiere CORS.
BOOKING_CORS_ALLOWED_ORIGINS=
