BOOKING_DB_NAME=booking
BOOKING_DB_USER=booking_app
BOOKING_DB_PASSWORD=
BOOKING_MYSQL_ROOT_PASSWORD=
BOOKING_DB_HOST=localhost
BOOKING_DB_PORT=3309
BOOKING_APP_HOST=127.0.0.1
BOOKING_APP_PORT=8081

# Base64 de al menos 32 bytes aleatorios. No usar el JWT de cátedra.
BOOKING_JWT_SECRET=
BOOKING_JWT_ISSUER=turnos-booking
BOOKING_JWT_AUDIENCE=turnos-backends
BOOKING_JWT_TTL=30m
# Vacío: no admite clientes web de otro origen. KMP nativo no requiere CORS.
BOOKING_CORS_ALLOWED_ORIGINS=

# JWT del usuario se propaga a catálogo; JWT técnico se usa solo con cátedra.
BOOKING_CATALOG_BASE_URL=http://localhost:8080
BOOKING_CATEDRA_BASE_URL=http://172.17.201.1:8090
BOOKING_CATEDRA_TOKEN=
BOOKING_AVAILABILITY_ZONE=America/Argentina/Mendoza
# En Docker, usar una dirección de catálogo accesible desde el contenedor.
BOOKING_DOCKER_CATALOG_BASE_URL=http://host.docker.internal:8080

# Activar con ZeroTier conectado y Kafka accesible. Mantener el mismo grupo al reiniciar.
BOOKING_KAFKA_ENABLED=false
BOOKING_KAFKA_BOOTSTRAP_SERVERS=172.17.201.1:9094
BOOKING_KAFKA_ACTIONS_TOPIC=alumnos.turnos.acciones.proyecto-pilar-machinea
BOOKING_KAFKA_CONSUMER_GROUP=alumnos-proyecto-pilar-machinea
